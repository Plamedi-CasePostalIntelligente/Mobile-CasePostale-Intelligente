<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_mailbox1_background"
    android:padding="16dp"
    tools:context=".ui.AdminHomeActivity">

    <!-- Titre -->
    <TextView
        android:id="@+id/adminHomeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestion des Villes"
        android:textSize="28sp"
        android:textColor="#333333"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Icône utilisateur (cliquable) -->
    <ImageView
        android:id="@+id/userIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:src="@drawable/ic_user"
        android:contentDescription="Utilisateur"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless" /> <!-- Effet ripple -->

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cityRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/adminHomeTitle"
        android:layout_alignParentBottom="true"
        android:scrollbars="vertical"
        android:padding="8dp"
        android:background="#FFFFFF" />
</RelativeLayout>