<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp"
    tools:context=".ui.DashboardAdminActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Titre "Tableau de bord" -->
            <TextView
                android:id="@+id/dashboardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tableau de bord"
                android:textSize="24sp"
                android:textColor="#333333"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Bouton de retour -->
            <Button
                android:id="@+id/backButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.12"
                app:layout_constraintHeight_percent="0.08"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/ic_menu_revert"
                android:contentDescription="Retour"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dashboardTitle" />

            <!-- Carte Température -->
            <androidx.cardview.widget.CardView
                android:id="@+id/temperatureCard"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.45"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toBottomOf="@id/backButton"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/temperatureTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Température"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/mqttTemperatureValue"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="25°C"
                        android:textSize="24sp"
                        android:textColor="#FF5722"
                        android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Carte OLED -->
            <androidx.cardview.widget.CardView
                android:id="@+id/oledCard"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.45"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toBottomOf="@id/backButton"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/oledTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Écran OLED"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/mqttOledValue"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="Actif"
                        android:textSize="24sp"
                        android:textColor="#4CAF50"
                        android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Carte RFID -->
            <androidx.cardview.widget.CardView
                android:id="@+id/rfidCard"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.45"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toBottomOf="@id/temperatureCard"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/rfidTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="RFID"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/mqttRfidValue"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="Aucune détection"
                        android:textSize="20sp"
                        android:textColor="#F44336"
                        android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Carte Ultrasonique -->
            <androidx.cardview.widget.CardView
                android:id="@+id/ultrasonicCard"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.45"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toBottomOf="@id/oledCard"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/ultrasonicTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ultrasonique"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/mqttUltrasonicValue"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="50 cm"
                        android:textSize="24sp"
                        android:textColor="#2196F3"
                        android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bouton "Tentatives de connexion" (Bleu) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/loginAttemptsButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                app:layout_constraintWidth_percent="0.5"
                android:text="Tentatives de connexion"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#2196F3"
                android:padding="8dp"
                android:elevation="4dp"
                app:cornerRadius="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

        <!-- Bouton vide (Rouge) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/emptyButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                app:layout_constraintWidth_percent="0.5"
                android:text=""
                android:backgroundTint="#F44336"
                android:padding="8dp"
                android:elevation="4dp"
                app:cornerRadius="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/loginAttemptsButton"
                app:layout_constraintEnd_toEndOf="parent"/>
                <!--android:onClick="onEmptyButtonClick"-->

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</RelativeLayout>